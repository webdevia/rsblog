# Production environment for docker-compose.yml (PostgreSQL).
# Copy to `.env` and fill in the secrets. NEVER commit `.env`.
#
#   cp .env.prod.example .env
#   # edit .env, then:
#   docker compose up -d --build

# --- Public HTTPS endpoint (Caddy: automatic Let's Encrypt certs) ---
# The domain must already point at this VPS (A/AAAA record).
DOMAIN=example.com
# Contact email for Let's Encrypt expiry notices. Must be a REAL address —
# example.com / placeholder domains are rejected by Let's Encrypt.
ACME_EMAIL=you@your-real-mailbox.com

# --- App port on the host (localhost-only; the world uses :443 via Caddy) ---
APP_PORT=3000

# --- PostgreSQL (no defaults for the password: compose fails fast if unset) ---
POSTGRES_USER=blog_user
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=blog_db
# Log only slow statements (>= ms) to keep disk usage low on a tiny VPS.
POSTGRES_LOG_MIN_DURATION_STATEMENT=1000

# --- Blog API ---
# Generate with: openssl rand -hex 48   (96 hex chars, >= 64 required)
JWT_SECRET=change-this-to-a-very-long-random-secret-key-at-least-64-chars-long-for-production
JWT_EXPIRATION_HOURS=24
# Keep logs quiet in prod; use blog_api=debug only when troubleshooting.
RUST_LOG=blog_api=info,tower_http=info,sqlx=warn
# Observability (all optional — compose defaults shown; uncomment to override).
# JSON access logs with x-request-id; /health excluded; bodies never logged.
# LOG_FORMAT=json
# Append ?query to access-log paths (off: query may contain PII).
# LOG_INCLUDE_QUERY=false
# Warn on requests slower than this (ms). 0 disables.
# SLOW_REQUEST_MS=1000
# --- Rate limiting & anti-spam (compose defaults shown) ---
# RATE_LIMIT_RPS=1
# RATE_LIMIT_BURST=60
# AUTH_RATE_RPS=1
# AUTH_RATE_BURST=5
# COMMENT_RATE_PER_MIN=5
# POST_RATE_PER_HOUR=10
# Max reports per user per hour (0 disables).
# REPORT_RATE_PER_HOUR=20
# TRUSTED_ACCOUNT_DAYS=30
# TRUSTED_PUBLISHED_COUNT=5
# DUPLICATE_WINDOW_MIN=60
# MAX_LINKS_NEW_USER=3

# --- Initial admin (seeded once when no admin exists; >= 12 chars) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@blog.com
ADMIN_PASSWORD=change-me-to-a-strong-password-12-chars-min

# --- Browser CORS allowlist (comma-separated). Unset = reflect any origin. ---
# CORS_ORIGINS=https://app.example
