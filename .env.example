DATABASE_BACKEND=sqlite
DATABASE_URL=sqlite://blog.db?mode=rwc
JWT_SECRET=change-this-to-a-very-long-random-secret-key-at-least-64-chars-long-for-production
JWT_EXPIRATION_HOURS=24
RUST_LOG=blog_api=debug,tower_http=debug,sqlx=warn
# Log output format: text (dev default) or json (production).
LOG_FORMAT=text
# Append ?query to access-log paths. Default false (query may contain PII).
# LOG_INCLUDE_QUERY=false
# Warn on requests slower than this (ms). 0 disables.
# SLOW_REQUEST_MS=1000
# --- Rate limiting (per IP) ---
# Sustained req/sec and burst for all traffic.
# RATE_LIMIT_RPS=1
# RATE_LIMIT_BURST=60
# Tighter bucket for /auth/* (mass-registration / brute-force).
# AUTH_RATE_RPS=1
# AUTH_RATE_BURST=5
# --- Anti-spam (per user; 0 disables where noted) ---
# Max comments per user per minute / posts per user per hour.
# COMMENT_RATE_PER_MIN=5
# POST_RATE_PER_HOUR=10
# Skip write throttles for accounts this old (days) or with this many posts.
# TRUSTED_ACCOUNT_DAYS=30
# TRUSTED_PUBLISHED_COUNT=5
# Reject identical content by same user within this window (minutes, 0 off).
# DUPLICATE_WINDOW_MIN=60
# Max http(s) links per post/comment for untrusted users (0 off).
# MAX_LINKS_NEW_USER=3
HOST=127.0.0.1
PORT=3000
# Initial admin account (only used when no admin exists).
# Override in your real `.env`; never commit secrets.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@blog.com
# Must be >= 12 chars. If unset, admin seeding is skipped (or set ADMIN_PASSWORD to enable).
# ADMIN_PASSWORD=
# Browser CORS allowlist, comma-separated. Unset = reflect any origin (dev default).
# CORS_ORIGINS=https://app.example
